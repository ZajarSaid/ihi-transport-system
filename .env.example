# Local SQLite database. Phase 7 swaps this for a Postgres connection string,
# e.g. postgresql://user:password@localhost:5432/trs?schema=public
DATABASE_URL="file:./prisma/dev.db"

# Turso / libSQL (https://turso.tech). When both are set, the app uses Turso
# instead of the local SQLite file above. DATABASE_URL is still used by the
# Prisma CLI (migrate/generate), not by the running app.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN=""

# Secret used to sign Auth.js session cookies (Phase 3).
AUTH_SECRET="replace-me-with-a-long-random-string"

# Resend (https://resend.com) — sends the driver assignment email.
# Leave RESEND_API_KEY or EMAIL_FROM unset to disable email; driver
# assignment still works, it is just skipped (and logged) server-side.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a verified domain in Resend, or "onboarding@resend.dev" for testing.
EMAIL_FROM="Transport Desk <transport@yourdomain.com>"
# Optional: address driver replies should go to.
EMAIL_REPLY_TO=""
# Optional: absolute URL used for the link in the email footer.
APP_URL="http://localhost:3000"
